# Copy this file to server/.env (the server reads its .env from the server folder).
# Never commit the real .env file.

# PostgreSQL started by `cd database && npm start` (or the Docker alternative)
DATABASE_URL="postgresql://hrms:hrms_local_dev@localhost:5433/hrms?schema=public"
TEST_DATABASE_URL="postgresql://hrms:hrms_local_dev@localhost:5433/hrms_test?schema=public"

# Authentication — change JWT_SECRET to any long random string
JWT_SECRET="replace-with-a-long-random-string"
SESSION_IDLE_MINUTES=20

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Optional: real LLM for the AI Concierge. Leave empty to use the built-in
# knowledge-base mode (the application works fully without a key).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Mock payment gateway: any card number ending in 0002 is declined,
# ending in 0003 times out. Everything else succeeds. See docs/API.md.
PAYMENT_GATEWAY_MODE="mock"
